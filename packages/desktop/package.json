{
  "name": "@ecoliko/desktop",
  "version": "0.1.0",
  "description": "EcoLiko desktop tray app — browser-extension-style AI impact dashboard",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc && concurrently \"tsc --watch --preserveWatchOutput\" \"nodemon --watch dist --ext js --delay 0.5 --exec \\\"electron dist/main.js\\\"\"",
    "start": "electron dist/main.js"
  },
  "dependencies": {
    "@ecoliko/core": "0.1.0",
    "electron": "^41.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "nodemon": "^3.0.0"
  },
  "license": "MIT"
}
