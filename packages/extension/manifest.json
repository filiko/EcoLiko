{
  "manifest_version": 3,
  "name": "EcoLiko - AI Environmental Impact Tracker",
  "version": "0.2.0",
  "description": "Track the water, electricity, and CO2 footprint of your AI usage — works with any AI tool",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.openai.com/*",
    "https://claude.ai/*",
    "https://api.anthropic.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://copilot.microsoft.com/*",
    "https://github.com/*",
    "https://www.perplexity.ai/*",
    "https://api.perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://api.mistral.ai/*",
    "https://console.groq.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.cohere.com/*",
    "https://api.cohere.ai/*",
    "https://coral.cohere.com/*",
    "https://app.together.ai/*",
    "https://api.together.xyz/*",
    "https://chat.deepseek.com/*",
    "https://api.deepseek.com/*",
    "https://grok.com/*",
    "https://api.x.ai/*",
    "https://huggingface.co/*",
    "https://api-inference.huggingface.co/*",
    "https://poe.com/*",
    "https://api.fireworks.ai/*",
    "https://api.replicate.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://antigravity.google/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://github.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://console.groq.com/*",
        "https://openrouter.ai/*",
        "https://coral.cohere.com/*",
        "https://app.together.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://huggingface.co/*",
        "https://poe.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://antigravity.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://github.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://console.groq.com/*",
        "https://openrouter.ai/*",
        "https://coral.cohere.com/*",
        "https://app.together.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://huggingface.co/*",
        "https://poe.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://antigravity.google/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://github.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://console.groq.com/*",
        "https://openrouter.ai/*",
        "https://coral.cohere.com/*",
        "https://app.together.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://huggingface.co/*",
        "https://poe.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://antigravity.google/*"
      ],
      "js": [
        "widget.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}